# API server
PORT=8000

# Local MariaDB/MySQL connection
DATABASE_URL="mysql://root@127.0.0.1:3306/mydb?connection_limit=5"

# Access token settings
JWT_SECRET="replace-me"
JWT_EXPIRES_IN="1d"

# Refresh token settings
REFRESH_SECRET="replace-me"
REFRESH_JWT_SECRET="replace-me"
REFRESH_JWT_EXPIRES_IN="7d"

# Redis configuration for local Ubuntu/WSL development
LOCAL_REDIS_HOST=127.0.0.1
LOCAL_REDIS_PORT=6379
LOCAL_REDIS_CLUSTER_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003
BULLMQ_SKIP_VERSION_CHECK=true
REDIS_CLUSTER_READS=all
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=your-username
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=your-database
AURA_INSTANCEID=your-instance-id
AURA_INSTANCENAME=your-instance-name